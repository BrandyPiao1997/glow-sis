# Copy to .env.local for local dev. Never commit real values.
# Production values go in Vercel → Project → Settings → Environment Variables.

# Postgres connection string (Vercel Postgres). When unset, the app uses
# a local JSON file under .data/ — LOCAL DEV ONLY, not production.
DATABASE_URL=

# Password protecting /admin and the admin API endpoints.
# If unset, /admin is open and shows a visible warning (dev only).
ADMIN_PASSWORD=
